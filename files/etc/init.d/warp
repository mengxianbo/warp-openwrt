#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

start_service() {
	. /lib/functions.sh
	config_load warp
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0

	CONFIG="/etc/usque/config.json"
	[ -s "$CONFIG" ] || {
		logger -t warp "No MASQUE config found. Run: warpctl register"
		return 0
	}

	config_get bind main bind '0.0.0.0'
	config_get socks_port main socks_port '32500'
	config_get http_port main http_port '32511'
	config_get username main username ''
	config_get password main password ''

	procd_open_instance socks
	procd_set_param command /usr/bin/usque -c "$CONFIG" socks -b "$bind" -p "$socks_port"
	if [ -n "$username" ] && [ -n "$password" ]; then
		procd_append_param command -u "$username" -w "$password"
	fi
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance http
	procd_set_param command /usr/bin/usque -c "$CONFIG" http-proxy -b "$bind" -p "$http_port"
	if [ -n "$username" ] && [ -n "$password" ]; then
		procd_append_param command -u "$username" -w "$password"
	fi
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger warp
}
