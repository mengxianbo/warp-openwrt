#!/bin/sh
set -eu

CONFIG=/etc/usque/config.json
LOCK=/var/lock/warp-masque-register.lock

case "${1:-}" in
  register)
    mkdir -p /etc/usque
    chmod 0700 /etc/usque

    # A valid-looking existing config is preserved; never create another account
    # just because the user clicked Register again.
    if [ -s "$CONFIG" ]; then
      echo "检测到已有 WARP 注册配置：$CONFIG"
      echo "已跳过注册，不会重复向 Cloudflare 注册。"
      exit 0
    fi

    mkdir -p /var/lock
    if ! mkdir "$LOCK" 2>/dev/null; then
      echo "注册任务正在执行，请稍后刷新页面查看结果。"
      exit 1
    fi
    trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT HUP INT TERM

    echo "正在向 Cloudflare 注册 WARP MASQUE 设备……"
    echo "已在本次主动注册操作中自动确认 Cloudflare 服务条款。"

    # usque register is interactive. Feed the TOS confirmation only from this
    # explicit register action so LuCI does not leave a background prompt hanging.
    if printf 'y\n' | /usr/bin/usque -c "$CONFIG" register -n OpenWrt-WARP; then
      if [ -s "$CONFIG" ]; then
        chmod 0600 "$CONFIG"
        echo "注册成功，配置已保存：$CONFIG"
        exit 0
      fi
      echo "注册命令结束，但没有生成配置文件。"
      exit 1
    else
      rc=$?
      echo "WARP 注册失败，usque 退出码：$rc"
      exit "$rc"
    fi
    ;;
  enroll)
    [ -s "$CONFIG" ] || { echo "尚未注册，请先执行 warpctl register"; exit 1; }
    /usr/bin/usque -c "$CONFIG" enroll
    chmod 0600 "$CONFIG"
    ;;
  start)
    [ -s "$CONFIG" ] || { echo "尚未注册，请先执行 warpctl register"; exit 1; }
    uci set warp.main.enabled='1'
    uci commit warp
    /etc/init.d/warp enable
    /etc/init.d/warp restart
    ;;
  stop)
    uci set warp.main.enabled='0'
    uci commit warp
    /etc/init.d/warp stop
    /etc/init.d/warp disable
    ;;
  restart)
    /etc/init.d/warp restart
    ;;
  status)
    echo "=== WARP MASQUE ==="
    uci show warp.main 2>/dev/null || true
    if [ -s "$CONFIG" ]; then echo "注册配置：已存在"; else echo "注册配置：未注册"; fi
    echo "SOCKS5 进程：$(pgrep -af 'usque.*socks' || true)"
    echo "HTTP 进程：$(pgrep -af 'usque.*http-proxy' || true)"
    /usr/bin/warp-route status 2>/dev/null || true
    ;;
  log)
    logread -e usque
    ;;
  *)
    echo "用法：warpctl {register|enroll|start|stop|restart|status|log}"
    exit 2
    ;;
esac
